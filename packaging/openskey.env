# openskey configuration, read by the systemd unit (EnvironmentFile=).
# One VAR=value per line; quote values that contain spaces. Every variable is
# described in the README ("Run"). Restart after a change:
#   sudo systemctl restart openskey

# The scanner's IP address (where the registration is sent). Required.
IPADDRESS=

# This host's IP address, as the scanner reaches it (where button presses are
# sent). Required.
HOST_IPADDRESS=

# The name shown on the scanner's panel under "Scan to PC".
NAME=Scanner

# The command per Scan-to-PC function, run as
#   sh -c '<command>' -- <device> <name>
# with the button event in the environment (SKEY_FUNC, SKEY_P1..SKEY_P4,
# SKEY_SEQ, SKEY_EVENT, ...). With Brother's brscan-skey package installed,
# its scripts can be used as they are, for example:
#   SKEY_FILE='/opt/brother/scanner/brscan-skey/script/scantofile.sh "$1"'
# A function without a working command shows on the panel but does nothing.
SKEY_FILE=
SKEY_IMAGE=
SKEY_OCR=
SKEY_EMAIL=

# Seconds between re-registrations (below the device's 360 s lease).
#KEEPALIVE_INTERVAL=120

# Files a scan command touches while a scan runs; the refresh is held back
# while one is fresh (colon-separated).
#SKEY_HOLD_FILES=/tmp/STATUS_SCAN

# Log every button datagram in full (for captures of other models).
#SKEY_DEBUG=1
